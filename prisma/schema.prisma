// Prisma schema for "The True Path Islam" — multi-lingual dawah platform.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity / staff (dawah supervisors who review AI answers and content)
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  SCHOLAR // dawah supervisor / reviewer
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())

  reviewedQuestions Question[] @relation("QuestionReviewer")
  approvedContent   ContentItem[] @relation("ContentApprover")
  auditLogs         AuditLog[]    @relation("AuditActor")
}

// ---------------------------------------------------------------------------
// Quran, translations & tafsir
// ---------------------------------------------------------------------------
model Surah {
  id            Int      @id @default(autoincrement())
  number        Int      @unique
  nameAr        String
  nameEn        String
  nameTranslit  String
  revelation    String // Meccan | Medinan
  verseCount    Int
  verses        Verse[]
}

model Verse {
  id            Int      @id @default(autoincrement())
  surahId       Int
  surah         Surah    @relation(fields: [surahId], references: [id], onDelete: Cascade)
  number        Int // global verse index (1..6236)
  numberInSurah Int
  textAr        String
  juz           Int?
  page          Int?
  translations  Translation[]
  tafsirs       Tafsir[]

  @@unique([surahId, numberInSurah])
  @@index([number])
}

model TranslationLanguage {
  code          String        @id // en, zh, hi, ja, ru, ar
  nameAr        String
  nameEn        String
  direction     String        @default("ltr")
  translations  Translation[]

  @@map("TranslationLanguage")
}

model Translation {
  id          Int                  @id @default(autoincrement())
  verseId     Int
  verse       Verse                @relation(fields: [verseId], references: [id], onDelete: Cascade)
  languageCode String
  language    TranslationLanguage  @relation(fields: [languageCode], references: [code])
  author      String
  text        String

  @@unique([verseId, languageCode, author])
  @@index([languageCode])
}

model TafsirSource {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameAr    String
  nameEn    String
  author    String
  language  String   @default("ar")
  tafsirs   Tafsir[]
}

model Tafsir {
  id        Int          @id @default(autoincrement())
  verseId   Int
  verse     Verse        @relation(fields: [verseId], references: [id], onDelete: Cascade)
  sourceId  Int
  source    TafsirSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text      String

  @@unique([verseId, sourceId])
}

// ---------------------------------------------------------------------------
// Hadith & the Prophet's biography (Seerah)
// ---------------------------------------------------------------------------
model HadithCollection {
  id        Int             @id @default(autoincrement())
  slug      String          @unique
  nameAr    String
  nameEn    String
  author    String?
  hadiths   Hadith[]
  books     HadithBook[]
}

enum HadithGrade {
  SAHIH   // authentic
  HASAN   // good
  DAIF    // weak
  UNKNOWN
}

model HadithBook {
  id           Int              @id @default(autoincrement())
  collectionId Int
  collection   HadithCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  number       Int
  nameAr       String?
  nameEn       String
  hadiths      Hadith[]

  @@unique([collectionId, number])
}

model Hadith {
  id           Int              @id @default(autoincrement())
  collectionId Int
  collection   HadithCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookId       Int?
  book         HadithBook?      @relation(fields: [bookId], references: [id], onDelete: SetNull)
  number       Int
  arabic       String
  english      String?
  grade        HadithGrade      @default(UNKNOWN)
  topics       HadithTopic[]    @relation("HadithTopics")

  @@unique([collectionId, number])
  @@index([grade])
}

model HadithTopic {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameAr    String
  nameEn    String
  hadiths   Hadith[] @relation("HadithTopics")
}

model BiographyEvent {
  id            Int     @id @default(autoincrement())
  order         Int
  era           String // e.g. "مكة" / "المدينة"
  year          String?
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
}

// ---------------------------------------------------------------------------
// Interactive Q&A engine
// ---------------------------------------------------------------------------
model QaCategory {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  nameAr    String
  nameEn    String
  questions Question[]
}

enum QuestionStatus {
  NEW          // awaiting review
  AI_DRAFTED   // AI produced a draft, pending scholar approval
  PUBLISHED    // approved and publicly visible
  REJECTED
}

model Question {
  id            String         @id @default(cuid())
  locale        String         @default("en")
  visitorName   String?
  visitorEmail  String?
  body          String
  categoryId    Int?
  category      QaCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status        QuestionStatus @default(NEW)

  aiDraft       String?
  aiConfidence  Float?
  aiProvider    String?
  aiModel       String?
  answerAr      String?
  answerEn      String?

  reviewedById  String?
  reviewedBy    User?          @relation("QuestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Shahada / new-Muslim onboarding track
// ---------------------------------------------------------------------------
model ShahadaStep {
  id        Int     @id @default(autoincrement())
  order     Int
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  isRite    Boolean @default(false) // marks the shahada pronouncement step
}

model ContactRequest {
  id         String   @id @default(cuid())
  name       String
  email      String
  language   String   @default("en")
  message    String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Platform configuration (owner branding, feature flags)
// ---------------------------------------------------------------------------
model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AI dawah-agent platform
//
// A registry of specialised agents (planner, researcher, writer, localizer,
// reviewer, publisher, analytics) that help publish introductory Islamic
// content in the platform's languages, targeting regions such as India,
// China and Japan. Every agent output is grounded, cited and — for anything
// religiously sensitive — held for human approval before publication.
// ---------------------------------------------------------------------------
enum AgentKind {
  PLANNER
  RESEARCHER
  WRITER
  LOCALIZER
  REVIEWER
  PUBLISHER
  ANALYTICS
}

enum AgentStatus {
  ACTIVE
  PAUSED
}

model Agent {
  id          String      @id @default(cuid())
  slug        String      @unique
  nameAr      String
  nameEn      String
  kind        AgentKind
  description String
  status      AgentStatus @default(ACTIVE)
  config      Json?
  createdAt   DateTime    @default(now())

  contentItems ContentItem[]
  auditLogs    AuditLog[]
}

enum Region {
  INDIA
  CHINA
  JAPAN
  GLOBAL
}

model Campaign {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  region    Region
  locales   String[] // subset of the platform's locale codes
  theme     String?  // weekly/monthly theme
  startDate DateTime?
  endDate   DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  contentItems ContentItem[]
  metrics      Metric[]
}

// Publication pipeline. Content only becomes PUBLISHED after a human approves
// the religiously sensitive draft (SCHOLAR_REVIEW -> APPROVED).
enum ContentStatus {
  DRAFT             // generated, not yet checked
  SOURCE_CHECKED    // sources verified by the researcher agent
  LOCALIZED         // adapted per target language
  SCHOLAR_REVIEW    // queued for a human reviewer
  APPROVED          // human-approved, ready to publish
  SCHEDULED         // queued for a specific time/region
  PUBLISHED         // live on a social platform
  REJECTED
  FAILED
}

enum ContentType {
  SOCIAL_POST
  VIDEO_SCRIPT
  ARTICLE
  QA
  INVITATION
}

model ContentItem {
  id            String        @id @default(cuid())
  campaignId    String?
  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agentId       String?
  agent         Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  locale        String
  region        Region        @default(GLOBAL)
  contentType   ContentType   @default(SOCIAL_POST)
  title         String?
  body          String
  status        ContentStatus @default(DRAFT)
  sourceRefs    Json?         // [{ label, kind, ref }] citations recorded by the researcher
  approvedById  String?
  approvedBy    User?         @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  publications Publication[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([locale])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  X
  TELEGRAM
}

// A connected account/page. Credentials are NEVER stored here — only the
// reference to an environment variable that holds the token.
model SocialAccount {
  id             String         @id @default(cuid())
  platform       SocialPlatform
  handle         String
  displayName    String?
  credentialEnv  String?        // name of the env var holding the API token
  scopes         String[]       // granted permissions
  region         Region         @default(GLOBAL)
  locales        String[]
  enabled        Boolean        @default(false)
  createdAt      DateTime       @default(now())

  publications Publication[]

  @@unique([platform, handle])
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
  BLOCKED   // halted by the kill switch or missing approval
}

model Publication {
  id             String            @id @default(cuid())
  contentId      String
  content        ContentItem       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  accountId      String?
  account        SocialAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  platform       SocialPlatform
  region         Region            @default(GLOBAL)
  locale         String
  status         PublicationStatus @default(PENDING)
  idempotencyKey String            @unique // prevents accidental duplicate posting
  remoteId       String?           // platform post id
  remoteUrl      String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  attempts       Int               @default(0)
  error          String?
  createdAt      DateTime          @default(now())

  @@index([status])
}

enum MetricKind {
  REACH
  ENGAGEMENT
  CLICKS
  SITE_VISITS
  FOLLOWERS
}

model Metric {
  id          String     @id @default(cuid())
  campaignId  String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform    SocialPlatform?
  locale      String?
  region      Region     @default(GLOBAL)
  kind        MetricKind
  value       Int
  capturedAt  DateTime   @default(now())
  source      String     @default("manual") // manual | platform_api

  @@index([kind])
  @@index([capturedAt])
}

// Immutable audit trail: who did what, when, and the result.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorType  String      @default("user") // user | agent | system
  action     String
  entityType String
  entityId   String?
  agentId    String?
  agent      Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  contentId  String?
  content    ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  detail     Json?
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
}
